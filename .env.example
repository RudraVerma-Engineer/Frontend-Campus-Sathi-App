# URL of the backend. On a real phone use your computer's LAN IP, e.g.
# http://192.168.1.10:5000/api/v1   (phone and PC must share the Wi-Fi)
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# Google sign-in (OAuth client IDs from Google Cloud Console). Optional.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
